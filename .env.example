# Copy to .env (git-ignored) and fill in. Never commit real values.
MAC=user@<mac-host>          # ssh target of the Mac mini serving Flint (rec serve on 127.0.0.1:11500; its key is fetched over ssh)
MAC_SSH_KEY=<path to the ssh identity for the Mac>
FLINT_URL=http://<mac-host>:11502/v1   # Flint through mac-tuning's LAN relay (scripts/install_launchd.sh on the Mac)
# LOCAL_PORT=11501           # only without FLINT_URL: the optional SSH tunnel listens here (loopback only)
